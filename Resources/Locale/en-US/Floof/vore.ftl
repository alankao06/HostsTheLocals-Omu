vore-attempt-devour = {CAPITALIZE($entity)} attempts to cram {CAPITALIZE($prey)}'s entire body into their mouth!
vore-attempt-insert = {CAPITALIZE($prey)} is trying to climb into {CAPITALIZE($entity)}'s mouth!
vore-devoured = {CAPITALIZE($prey)} disappears down {CAPITALIZE($entity)}'s gullet.
vore-digest-start = {CAPITALIZE($entity)}'s stomach groans and squelches...
vore-digest-start-chat = [color=red]{CAPITALIZE($entity)}'s stomach groans and squelches...[/color]
vore-digest-stop = {CAPITALIZE($entity)}'s stomach seems to calm down...
vore-released = {CAPITALIZE($entity)} is expelled from {CAPITALIZE($pred)}'s body.

vore-digested-owner-1 = [color=red]You feel {CAPITALIZE($entity)} body succumb to your digestive system, which breaks it apart into soft slurry.[/color]
vore-digested-owner-2 = [color=red]You hear a lewd glorp as your stomach's muscles grind {CAPITALIZE($entity)} into a warm pulp.[/color]
vore-digested-owner-3 = [color=red]Your stomach lets out a rumble as it melts {CAPITALIZE($entity)} into sludge.[/color]
vore-digested-owner-4 = [color=red]You feel a soft gurgle as {CAPITALIZE($entity)}'s body loses form in your stomach. They're nothing but a soft mass of churning slop now.[/color]
vore-digested-owner-5 = [color=red]Your stomach begins gushing {CAPITALIZE($entity)}'s remains through your system, adding some extra weight to your stomach.[/color]
vore-digested-owner-6 = [color=red]Your stomach groans as {CAPITALIZE($entity)} falls apart into a thick soup. You can feel their remains soon flowing deeper into your body to be absorbed.[/color]
vore-digested-owner-7 = [color=red]Your stomach kneads on every fiber of {CAPITALIZE($entity)}, softening them down into mush to fuel your next hunt.[/color]
vore-digested-owner-8 = [color=red]Your stomach churns {CAPITALIZE($entity)} down into a hot slush. You can feel the nutrients coursing through your digestive track with a series of long, wet glorps.[/color]

